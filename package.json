{
  "name": "vibespire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.engine.json",
    "deploy": "npm run build && sh scripts/build-v1.sh && wrangler deploy",
    "sim": "tsx sim/batch.ts",
    "e2e": "tsx tests/e2e/cli.ts full",
    "e2e:smoke": "tsx tests/e2e/cli.ts smoke",
    "e2e:actions": "tsx tests/e2e/cli.ts actions",
    "e2e:input": "tsx tests/e2e/cli.ts input",
    "e2e:bosses": "tsx tests/e2e/cli.ts bosses",
    "e2e:scenarios": "tsx tests/e2e/cli.ts scenarios"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.155.0"
  }
}
